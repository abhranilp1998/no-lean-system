<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/no_lean_widget_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/radar_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/radar_description"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/radar_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:textColor="@color/widget_cyan"
        android:textSize="11sp"
        android:textStyle="bold" />
</FrameLayout>

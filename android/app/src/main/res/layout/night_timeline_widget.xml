<?xml version="1.0" encoding="utf-8"?>
<!-- Full-size night timeline. Rows fill the height, so a tall widget gets taller
     rows instead of a small block floating in empty space. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/night_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/no_lean_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/night_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="@string/night_title"
            android:textColor="@color/widget_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/night_window"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/night_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:maxLines="2"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/night_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/night_action_sos"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/no_lean_widget_sos_button"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="@string/night_action_support"
        android:textColor="@color/widget_red"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>

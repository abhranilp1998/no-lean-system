<?xml version="1.0" encoding="utf-8"?>
<!-- Any full-screen view, plus a small button that cycles the view. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stretched_host"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/stretched_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/stretched_cycle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:contentDescription="@string/stretched_cycle"
        android:padding="10dp"
        android:src="@drawable/stretched_cycle" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Tall classic: header and timer on top, discreet milestone progress in
     the middle, normal-height buttons anchored at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/no_lean_widget_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="@string/widget_title"
            android:textColor="@color/widget_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/widget_status_stable"
            android:textColor="@color/widget_toxic"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/widget_clean_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:text="@string/widget_counter_placeholder"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Privacy mode: replaces the counter with neutral copy. -->
    <TextView
        android:id="@+id/widget_neutral"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:text="@string/widget_neutral"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="@string/widget_streak_placeholder"
            android:textColor="@color/widget_toxic"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_pledge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/widget_pledge_pending"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Tall only: discreet progress fills the middle; buttons stay normal
         height at the bottom. -->
    <LinearLayout
        android:id="@+id/widget_middle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_milestone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:singleLine="true"
            android:text="@string/widget_milestone_placeholder"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/widget_milestone_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/no_lean_widget_milestone_progress" />

        <TextView
            android:id="@+id/widget_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.2"
            android:singleLine="true"
            android:text="@string/widget_week_placeholder"
            android:textColor="@color/widget_toxic"
            android:textSize="14sp" />

        <!-- Privacy mode: just the date, nothing about recovery. -->
        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:textColor="@color/widget_muted"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_action_sos"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/no_lean_widget_sos_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="@string/widget_action_sos"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_action_craving"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/no_lean_widget_craving_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="@string/widget_action_craving"
            android:textColor="@color/widget_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_action_relapse"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/no_lean_widget_craving_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="@string/widget_action_relapse"
            android:textColor="@color/widget_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wave_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/no_lean_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/wave_art"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/wave_widget_title"
        android:scaleType="fitCenter"
        android:src="@drawable/wave_art" />

    <TextView
        android:id="@+id/wave_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/wave_widget_title"
        android:textColor="@color/widget_cyan"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/wave_widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/wave_widget_hint"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
</LinearLayout>
